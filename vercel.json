{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/realm",
      "destination": "/kingdom/",
      "permanent": false
    },
    {
      "source": "/realm/(.*)",
      "destination": "/kingdom/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/kingdom/play/(assets|cdn|art)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
